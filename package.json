{
  "name": "pacasa",
  "version": "0.1.0",
  "private": true,
  "description": "Pa'Casa — a universal spatial app for mobile, web and headsets.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:workspace": "turbo dev",
    "build:workspace": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "gen": "node tooling/generators/gen.mjs",
    "spatial:prepare-web": "node tooling/copy-viro-web-assets.mjs",
    "skia:prepare-web": "node tooling/copy-skia-web-assets.mjs",
    "postinstall": "node tooling/copy-viro-web-assets.mjs && node tooling/copy-skia-web-assets.mjs && node tooling/copy-rive-web-runtime.mjs",
    "spatial:verify-android": "node tooling/verify-spatial-android.mjs",
    "spatial:verify-typegpu": "node tooling/verify-typegpu-toolchain.mjs",
    "verify:routes": "node tooling/verify-five-routes.mjs",
    "rive:build": "node tooling/build-rive.mjs",
    "verify:rive": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tooling/verify-rive-assets.mjs",
    "build:base44": "vite build",
    "base44:setup": "npm ci --prefix tooling/base44-cli",
    "base44:deploy": "npm exec --prefix tooling/base44-cli -- base44 deploy -y --no-build"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.52",
    "@tanstack/react-query": "^5.90.21",
    "lucide-react": "^0.475.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.6",
    "sonner": "^2.0.7",
    "vite": "8.2.0"
  },
  "devDependencies": {
    "@base44/vite-plugin": "^1.0.44",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.24",
    "playwright": "1.64.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "turbo": "^2.11.7"
  }
}
