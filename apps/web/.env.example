# apps/web: the NYC-MON product and promo site. Payload, its admin and Better
# Auth run in apps/admin-vite (docs/adr/0003-admin-app-split.md), so this app
# holds no database or auth secrets. Prefer the workspace root .env.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Mapbox public token (pk.*) for the Preguntar directions card. URL-restricted
# public key; the real value lives in the workspace root .env.local.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
