# Server-only values, never EXPO_PUBLIC_ or NEXT_PUBLIC_.
# GEMINI_API_KEY is preferred; GOOGLE_GEMINI (the moyo env name) is accepted.
# `pnpm --filter assistant-api dev` loads the repo-root .env.local automatically.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PACASA_ALLOWED_ORIGINS=http://localhost:3000
HOST=127.0.0.1
PORT=8787

# Optional: enable verified Places directions plus private static map proxy.
# Enable Google Places API (New) and Maps Static API in your own billed project.
GOOGLE_MAPS_API_KEY=

# Optional demo-only browser OCR for PDF/JPEG/PNG uploads and the camera scan.
# NEVER enable with production PHI until auth, BAA, privacy controls and audit pass.
PACASA_ENABLE_DEMO_DOC_OCR=0

# Optional: ElevenLabs voice for the Hablar spoken translations.
# Without it, Talk falls back to the device's own text-to-speech.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
