# Pa'Casa server deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Postgres only. Better Auth is the identity layer.
# Project: https://supabase.com/dashboard/project/bjkphdrwnctszwrrqecx
# DATABASE_URL must be the Postgres connection URI, NOT an sb_publishable_/sb_secret_ API key.
# Public Data API values below are optional for future use and do not connect Better Auth.
NEXT_PUBLIC_SUPABASE_URL=https://bjkphdrwnctszwrrqecx.supabase.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_84MeuaZMm9h1rIN4ESaVSw_NjLMemRe
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# Never expose DATABASE_URL or BETTER_AUTH_SECRET to NEXT_PUBLIC_* variables.

# Set to 1 when the Base44 browser UI and auth API are on different origins.
BETTER_AUTH_CROSS_ORIGIN=1

# Optional override; the default synthetic demo password is PaCasa-Demo-2026!
PACASA_DEMO_PASSWORD=
