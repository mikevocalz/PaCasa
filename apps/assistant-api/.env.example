# Server-only values, never EXPO_PUBLIC_ or NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PACASA_ALLOWED_ORIGINS=http://localhost:3000
HOST=127.0.0.1
PORT=8787

# Optional: enable verified Places directions plus private static map proxy.
# Enable Google Places API (New) and Maps Static API in your own billed project.
GOOGLE_MAPS_API_KEY=

# Optional demo-only browser OCR. NEVER enable with production PHI until auth, BAA, privacy controls and audit pass.
PACASA_ENABLE_DEMO_DOC_OCR=0
