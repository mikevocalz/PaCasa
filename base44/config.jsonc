{
  "name": "Pa'Casa",
  "visibility": "public",
  "site": {
    // The Base44 surface is the root Vite app (index.html + src/), not the
    // Expo/Next workspace, which keeps its own turbo build (pnpm build:workspace).
    "buildCommand": "vite build",
    "serveCommand": "vite",
    "outputDirectory": "./dist",
    "installCommand": "pnpm install --no-frozen-lockfile || npm install --no-audit --no-fund"
  }
}