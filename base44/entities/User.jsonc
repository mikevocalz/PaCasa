{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "displayName": {
      "type": "string",
      "description": "Name the person uses in Pa'Casa"
    },
    "accountType": {
      "type": "string",
      "description": "Which portal the account opens",
      "enum": [
        "patient",
        "provider"
      ],
      "default": "patient"
    },
    "accountStatus": {
      "type": "string",
      "description": "Provider accounts stay pending until the clinic approves the membership",
      "enum": [
        "active",
        "pending"
      ],
      "default": "active"
    },
    "organization": {
      "type": "string",
      "description": "Clinic slug for provider accounts"
    },
    "preferredLanguage": {
      "type": "string",
      "description": "Language preference for the portal"
    }
  },
  "required": [
    "role"
  ]
}