# Pa'Casa root/Base44 Vite surface.
# Keep real values in .env.local, never in git.

# Better Auth backend origin. Leave empty to use the explicit in-browser demo sessions.
VITE_PACASA_AUTH_URL=

# Public Supabase Data API project config (not used for Better Auth identity).
# A PostgreSQL DATABASE_URL is still required on the separate auth server.
VITE_SUPABASE_URL=https://bjkphdrwnctszwrrqecx.supabase.com
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_84MeuaZMm9h1rIN4ESaVSw_NjLMemRe

# ReactVision / Viro project credentials, read by the Viro config plugin at prebuild.
EXPO_PUBLIC_REACTVISION_API_KEY=
EXPO_PUBLIC_REACTVISION_PROJECT_ID=
EXPO_PUBLIC_REACTVISION_ENDPOINT=https://platform.reactvision.xyz

# Headset app ids. PICO OS ends the process without one, so set it before a picoDebug build.
EXPO_PUBLIC_META_QUEST_APP_ID=
PICO_APP_ID=
